STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# ── DATABASE_URL ───────────────────────────────────────────────────────────
# ⚠️ Local dev MUST use the Neon **dev** branch, NOT prod. Prod (`main` branch)
# and local dev previously shared one URL, so `medusa develop`/`exec` wrote to
# prod (that's how 70+ duplicate stores/keys appeared). Keep them separate:
#   • Local dev → Neon `dev` branch (ep-twilight-poetry-*). Fetch with:
#       neonctl connection-string dev --project-id shiny-paper-72860331 --pooled
#   • Prod → Neon `main` branch — lives ONLY in GCP Secret Manager / Cloud Run.
#   • One-off prod ops (backfill, cleanup): put the prod URL in `.env.prod`
#     (gitignored) and run e.g. `dotenv -e .env.prod -- npx medusa exec …`.
DATABASE_URL=
DB_NAME=medusa-backend
# Pin the storefront sales channel so product creation never guesses among stores.
MEDUSA_SALES_CHANNEL_ID=sc_01KSK1J0V81P4EPY9G0JAPX353
# Market-owned Medusa resources. `MEDUSA_*_PUBLISHABLE_KEY` values are public
# `pk_…` tokens; every other value below is a Medusa row id. Never put an `apk_…`
# database id into a publishable-key variable.
MEDUSA_MXN_REGION_ID=
MEDUSA_MX_OPERATING_CHANNEL_ID=
MEDUSA_PUBLISHABLE_KEY=
# Required before deploying market-scoped inventory writers. Authenticated
# GET /internal/us-commerce-provision proves/exposes the existing MX id from both
# configured MX channel links plus manual-provider ownership; it never guesses by age.
MEDUSA_STOCK_LOCATION_ID=
MEDUSA_US_REGION_ID=
MEDUSA_US_MARKETPLACE_CHANNEL_ID=
MEDUSA_US_OPERATING_CHANNEL_ID=
MEDUSA_US_PUBLISHABLE_KEY=
MEDUSA_US_STOCK_LOCATION_ID=
# The platform-owned seller that bills print-ad placements + mints platform/
# referral coupons (see src/api/internal/_utils/platform-seller.ts). No
# code-level fallback — required for /internal/print/placement-product and
# /internal/platform-coupons to resolve a seller at all.
PLATFORM_SELLER_SLUG=miyagiprints
